# Copy to `.env` next to docker-compose.yml and fill in real values.
# `.env` is gitignored. There are no defaults for the secrets on purpose.

# ─── MySQL ───────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=paris_fraicheur
MYSQL_USER=paris_app
MYSQL_PASSWORD=
MYSQL_PORT=3306

# ─── Go API ──────────────────────────────────────────────────────────────────
# Comma-separated. Must include wherever the Vite dev server is listening.
ALLOWED_ORIGINS=http://localhost:5173

# ─── Symfony back-office ─────────────────────────────────────────────────────
SYMFONY_SECRET=
ADMIN_USERNAME=admin
# Generate with: docker compose run --rm admin php bin/console security:hash-password
ADMIN_PASSWORD_HASH=

# ─── Airflow ─────────────────────────────────────────────────────────────────
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=

# ─── BigQuery (optional) ─────────────────────────────────────────────────────
# Leave GCP_PROJECT empty to run the pipeline against MySQL only.
# To enable the BigQuery task, set it and drop a service-account key at
# deploy/keys/gcp-sa.json (that directory is gitignored).
GCP_PROJECT=
BQ_DATASET=paris_fraicheur
