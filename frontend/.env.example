# ─── Open Data Paris ─────────────────────────────────────────────────────────
# No API key required. Override only to point at a proxy or a fixture server.
# VITE_OPENDATA_BASE_URL=https://opendata.paris.fr/api/explore/v2.1/catalog/datasets

# ─── Logging ─────────────────────────────────────────────────────────────────
# 'false' silences every non-error log (errors always log).
VITE_ENABLE_LOGS=true

# ─── Backend API (services/api-go, in front of MySQL) ────────────────────────
# Origin only — the client appends /api/v1/... itself.
# Leave it unset to normalize Open Data Paris in the browser instead; the
# dashboard runs either way, so a fresh clone needs no backend.
VITE_API_BASE_URL=http://localhost:8080
